.header {
  padding: 24rpx 24rpx 12rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
}
.subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* 选择卡片 */
.select-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx;
}
.select-slot {
  width: 180rpx;
  height: 220rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.select-slot.filled {
  border-style: solid;
  border-color: var(--accent);
}
.select-slot:active {
  background: rgba(0, 240, 255, 0.05);
}
.slot-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}
.slot-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.slot-plus {
  font-size: 48rpx;
  color: var(--text-secondary);
}
.slot-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.slot-name {
  font-size: 26rpx;
  font-weight: 600;
}
.vs-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--warning);
}

/* 对比表格 */
.compare-table {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.compare-row {
  display: flex;
  align-items: center;
}
.compare-cell {
  flex: 1;
  text-align: center;
}
.compare-cell.left {
  text-align: right;
}
.compare-cell.right {
  text-align: left;
}
.compare-cell.center {
  flex: 0.6;
}
.compare-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.compare-value {
  font-size: 28rpx;
  font-weight: 600;
}

/* 标签对比 */
.tag-compare {
  display: flex;
  gap: 24rpx;
}
.tag-side {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.tag-side:last-child {
  justify-content: flex-end;
}

/* 海克斯对比 */
.augment-compare {
  display: flex;
  gap: 16rpx;
}
.augment-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.augment-item {
  background: var(--bg);
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  display: flex;
  justify-content: space-between;
}
.augment-name {
  font-size: 22rpx;
}
.augment-wr {
  font-size: 22rpx;
  color: var(--recommend);
}

/* 结论 */
.conclusion-card {
  text-align: center;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.1), rgba(0, 255, 136, 0.1));
  border-color: var(--accent);
}
.conclusion-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent);
}

/* 英雄选择弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.picker-panel {
  width: 100%;
  height: 70vh;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border);
}
.picker-title {
  font-size: 30rpx;
  font-weight: 600;
}
.picker-close {
  font-size: 28rpx;
  color: var(--accent);
}
.picker-search {
  padding: 16rpx 24rpx;
}
.picker-search input {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  color: var(--text);
  font-size: 28rpx;
}
.picker-list {
  flex: 1;
  padding: 0 24rpx;
}
.picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.picker-item:active {
  background: rgba(0, 240, 255, 0.05);
}
.picker-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}
.picker-name {
  font-size: 28rpx;
}
