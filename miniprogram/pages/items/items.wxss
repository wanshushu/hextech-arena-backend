.header {
  padding: 24rpx 24rpx 12rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx 16rpx;
  gap: 16rpx;
}
.sort-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
  color: var(--text-secondary);
}
.sort-btn.active {
  border-color: var(--accent);
  color: var(--accent);
  background: rgba(0, 240, 255, 0.1);
}
.item-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 装备列表 */
.item-list {
  padding: 0 24rpx;
}
.item-card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: var(--bg);
}
.item-info {
  flex: 1;
}
.item-name {
  font-size: 28rpx;
  font-weight: 600;
}
.item-plain {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.item-price {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--t3);
}
.item-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.stats-text {
  font-size: 22rpx;
  color: var(--recommend);
  line-height: 1.5;
}
