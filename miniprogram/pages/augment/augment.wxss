/* 英雄信息栏 */
.hero-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}
.hero-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid var(--accent);
}
.hero-info {
  flex: 1;
}
.hero-name {
  font-size: 30rpx;
  font-weight: 600;
}
.hero-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}
.hero-wr {
  font-size: 24rpx;
  color: var(--recommend);
}

/* 等级选择 */
.level-row {
  display: flex;
  gap: 12rpx;
}
.level-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  font-size: 26rpx;
  color: var(--text-secondary);
}
.level-btn.active {
  background: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
  font-weight: 600;
}

/* 已选海克斯 */
.selected-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.selected-tag {
  background: rgba(0, 255, 136, 0.15);
  border: 1rpx solid var(--recommend);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--recommend);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.remove-btn {
  font-size: 28rpx;
  color: var(--warning);
  padding: 0 4rpx;
}

/* 说明卡片 */
.instruction-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 51, 102, 0.08);
  border-color: var(--warning);
}
.instruction-icon {
  font-size: 32rpx;
}
.instruction-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}
.instruction-count {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

/* 海克斯列表 */
.augment-list {
  padding: 0 24rpx 200rpx;
}
.augment-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}
.augment-row.selected {
  border-color: var(--accent);
  background: rgba(0, 240, 255, 0.08);
}
.augment-row.previous {
  opacity: 0.5;
}
.augment-row:active {
  opacity: 0.8;
}
.augment-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--accent);
}
.augment-row.selected .augment-check {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--bg);
  font-weight: 700;
}
.augment-info {
  flex: 1;
}
.augment-name {
  font-size: 26rpx;
  font-weight: 500;
}
.augment-meta {
  margin-top: 4rpx;
}
.augment-wr {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--recommend);
  min-width: 80rpx;
  text-align: right;
}

/* 推荐栏（固定底部） */
.recommend-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card);
  border-top: 1rpx solid var(--border);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.recommend-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.recommend-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.recommend-icon {
  font-size: 36rpx;
}
.recommend-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}
.recommend-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--recommend);
}
.refresh-hint {
  font-size: 22rpx;
  color: var(--warning);
}
