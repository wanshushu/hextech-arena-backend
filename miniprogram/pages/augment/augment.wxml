<view class="container">
  <!-- 英雄信息 -->
  <view class="hero-bar card" wx:if="{{champion}}">
    <image class="hero-icon" src="{{champion.image_url}}" mode="aspectFill" />
    <view class="hero-info">
      <view class="hero-name">{{champion.name}}</view>
      <view class="hero-meta">
        <text class="tier-tag tier-{{champion.tier}}">{{champion.tier}}</text>
        <text class="hero-wr">胜率 {{champion.winrate}}</text>
      </view>
    </view>
  </view>

  <!-- 等级选择 -->
  <view class="card">
    <view class="section-title">📊 当前等级</view>
    <view class="level-row">
      <view
        wx:for="{{levels}}"
        wx:key="*this"
        class="level-btn {{currentLevel === item ? 'active' : ''}}"
        bindtap="onLevelTap"
        data-level="{{item}}"
      >{{item}}级</view>
    </view>
  </view>

  <!-- 已选海克斯（之前选过的） -->
  <view class="card" wx:if="{{selected.length > 0}}">
    <view class="section-title">✅ 已选海克斯 ({{selected.length}})</view>
    <view class="selected-list">
      <view class="selected-tag" wx:for="{{selected}}" wx:key="*this">
        {{item}}
        <text class="remove-btn" bindtap="onRemoveSelected" data-index="{{index}}">×</text>
      </view>
    </view>
  </view>

  <!-- 选择模式说明 -->
  <view class="card instruction-card">
    <text class="instruction-icon">🎯</text>
    <text class="instruction-text">从下方列表点选系统给你的3个海克斯</text>
    <text class="instruction-count" wx:if="{{available.length > 0}}">{{available.length}}/3</text>
  </view>

  <!-- 搜索 -->
  <view class="search-bar">
    <input
      placeholder="搜索海克斯..."
      placeholder-style="color: #666"
      bindinput="onSearch"
      value="{{searchText}}"
    />
  </view>

  <!-- 海克斯列表 -->
  <view class="augment-list">
    <view
      wx:for="{{filteredAugments}}"
      wx:key="name"
      class="augment-row {{item._selected ? 'selected' : ''}} {{item._isPrevious ? 'previous' : ''}}"
      bindtap="onAugmentTap"
      data-name="{{item.name}}"
    >
      <view class="augment-check">
        <text wx:if="{{item._selected}}">✓</text>
        <text wx:elif="{{item._isPrevious}}">-</text>
      </view>
      <view class="augment-info">
        <view class="augment-name">{{item.name}}</view>
        <view class="augment-meta">
          <text class="tier-tag tier-{{item.tier}}" wx:if="{{item.tier}}">{{item.tier}}</text>
        </view>
      </view>
      <view class="augment-wr">{{item.winrate || '-'}}</view>
    </view>
  </view>

  <!-- 推荐结果（固定在底部） -->
  <view class="recommend-bar" wx:if="{{result}}">
    <view class="recommend-content">
      <view class="recommend-left">
        <text class="recommend-icon">⭐</text>
        <view>
          <text class="recommend-label">推荐选择</text>
          <text class="recommend-name">{{result.recommendation}}</text>
        </view>
      </view>
      <view class="recommend-right" wx:if="{{result.refresh_advice.should_refresh}}">
        <text class="refresh-hint">🔄 {{result.refresh_advice.reason}}</text>
      </view>
    </view>
  </view>
</view>
