.header {
  padding: 24rpx 24rpx 12rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(90deg, var(--accent), var(--recommend));
  -webkit-background-clip: text;
  color: transparent;
}
.subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* 操作按钮 */
.action-card {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}
.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0;
  border-radius: 16rpx;
  background: var(--bg);
  border: 1rpx dashed var(--border);
}
.action-btn:active {
  background: rgba(0, 240, 255, 0.1);
  border-color: var(--accent);
}
.action-icon {
  font-size: 48rpx;
}
.action-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 预览图片 */
.preview-img {
  width: 100%;
  border-radius: 12rpx;
}
.ocr-status {
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 识别结果 */
.names-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.name-tag {
  background: rgba(0, 240, 255, 0.1);
  border: 1rpx solid var(--accent);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.name-remove {
  color: var(--warning);
  font-size: 28rpx;
}
.analyze-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, var(--accent), var(--recommend));
  color: var(--bg);
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

/* 阵容构成 */
.comp-grid {
  display: flex;
  justify-content: space-around;
}
.comp-item {
  text-align: center;
}
.comp-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}
.comp-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
}

/* 英雄列表 */
.hero-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.hero-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 16rpx;
}
.hero-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}
.hero-info {
  flex: 1;
}
.hero-name {
  font-size: 26rpx;
  font-weight: 600;
}
.hero-tags {
  margin-top: 4rpx;
}
.hero-stats {
  text-align: right;
}
.hero-wr {
  font-size: 22rpx;
  color: var(--recommend);
  display: block;
  margin-top: 4rpx;
}

/* 优劣势 */
.point-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.point {
  font-size: 26rpx;
  padding: 8rpx 0;
}
.point.good {
  color: var(--recommend);
}
.point.bad {
  color: var(--warning);
}

/* 综合评分 */
.score-card {
  text-align: center;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.1), rgba(0, 255, 136, 0.1));
  border-color: var(--accent);
}
.score-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.score-value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--recommend);
  margin: 12rpx 0;
}
.score-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 手动输入 */
.manual-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.manual-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.manual-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  color: var(--accent);
  font-size: 24rpx;
}
