/* 英雄头部 */
.hero-section {
  position: relative;
  height: 360rpx;
  overflow: hidden;
}
.hero-splash {
  width: 100%;
  height: 100%;
}
.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 24rpx;
  background: linear-gradient(transparent, rgba(10, 10, 15, 0.95));
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}
.hero-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid var(--accent);
}
.hero-info {
  flex: 1;
}
.hero-name {
  font-size: 40rpx;
  font-weight: 700;
}

/* 收藏按钮 */
.fav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #888;
}
.fav-btn.active {
  color: #FFD700;
}
.fav-btn:active {
  opacity: 0.7;
}
.hero-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.hero-tags {
  margin-top: 8rpx;
}

/* 数据栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 24rpx;
}
.stat-item {
  text-align: center;
}
.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}
.stat-value.recommend {
  color: var(--recommend);
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* 技能 */
.skill-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.skill-item {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx;
}
.skill-key {
  display: inline-block;
  background: var(--accent);
  color: var(--bg);
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}
.skill-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.skill-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 海克斯 */
.augment-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.augment-row {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  gap: 16rpx;
}
.augment-rank {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent);
  width: 50rpx;
}
.augment-name {
  flex: 1;
  font-size: 26rpx;
}
.augment-tier {
  font-size: 22rpx;
  color: var(--t2);
}
.augment-wr {
  font-size: 24rpx;
  color: var(--recommend);
  font-weight: 600;
  min-width: 90rpx;
  text-align: right;
}

/* 装备标签 */
.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.item-tag {
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

/* 速查模式入口 */
.quick-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.9), rgba(20, 20, 40, 0.9));
  border-color: #00ff88;
}
.quick-entry:active { opacity: 0.8; }
.quick-entry-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.quick-entry-icon {
  font-size: 40rpx;
}
.quick-entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #00ff88;
}
.quick-entry-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.quick-entry-arrow {
  font-size: 36rpx;
  color: var(--text-secondary);
}

/* 海克斯推荐入口 */
.augment-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(255, 51, 102, 0.1), rgba(0, 240, 255, 0.05));
  border-color: var(--accent);
}
.augment-entry:active {
  opacity: 0.8;
}
.augment-entry-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.augment-entry-icon {
  font-size: 40rpx;
}
.augment-entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent);
}
.augment-entry-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.augment-entry-arrow {
  font-size: 36rpx;
  color: var(--text-secondary);
}
